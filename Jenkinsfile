pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Đang clone code từ GitHub thành công!'
            }
        }
        stage('Build & Test') {
            steps {
                echo 'Đang thực hiện build ứng dụng...'
                // Thêm các lệnh build của bạn tại đây (ví dụ: sh 'mvn clean install')
            }
        }
    }
}
